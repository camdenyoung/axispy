# Copy to .env and edit; never commit the actual .env file.
# Use single quotes for passwords containing $, #, or spaces.
AXIS_J1_URL=https://192.168.1.101
AXIS_J1_USERNAME=operator
AXIS_J1_PASSWORD='replace-me'
AXIS_J2_URL=https://192.168.1.102
AXIS_J2_USERNAME=operator
AXIS_J2_PASSWORD='replace-me'
AXIS_J3_URL=https://192.168.1.103
AXIS_J3_USERNAME=operator
AXIS_J3_PASSWORD='replace-me'
AXIS_J4_URL=https://192.168.1.104
AXIS_J4_USERNAME=operator
AXIS_J4_PASSWORD='replace-me'

# Confirmed T8311 mappings are built in. Optional overrides:
# AXIS_DEVICE=0
# AXIS_PAN_AXIS=0
# AXIS_TILT_AXIS=1
# AXIS_ZOOM_AXIS=2
# AXIS_INVERT_TILT=true
# AXIS_CAMERA_BUTTONS=0,1,2,3
# AXIS_DEADZONE=0.18
# AXIS_MAX_PAN=70
# AXIS_MAX_TILT=70
# AXIS_MAX_ZOOM=50
# Optional per-camera overrides (J1-J4); unset/blank uses the global default.
# AXIS_J1_MAX_ZOOM=30
# AXIS_J2_MAX_ZOOM=50
# AXIS_J1_MAX_PAN=60
# AXIS_J1_MAX_TILT=60
# AXIS_FOCUS_NEAR_BUTTON=4
# AXIS_FOCUS_FAR_BUTTON=5
# AXIS_FOCUS_SPEED=30
# AXIS_DEADMAN_BUTTON=-1
# AXIS_RATE_HZ=10
# AXIS_TIMEOUT=0.5
# AXIS_FOCUS_TIMEOUT=2.0
# Hold J1-J4 this many seconds to re-enable autofocus (positive; decimals allowed).
# Unset or blank uses the default of 5 seconds.
# AXIS_AUTOFOCUS_HOLD_SECONDS=5
# AXIS_CONTINUOUS_TIMEOUT=2
# Persistent Docker logs: host directory (relative to compose.yaml or absolute).
# AXIS_LOG_DIR=./logs
# Rotation: 10 MiB per file plus 3 backups by default.
# AXIS_LOG_MAX_BYTES=10485760
# AXIS_LOG_BACKUP_COUNT=3
# Native executable/source only: optional file path; Compose sets this itself.
# AXIS_LOG_FILE=/path/to/axispy.log
# Per camera, AXIS_J1_CHANNEL=1 and AXIS_J1_CA_BUNDLE=/certs/camera-ca.pem
# are also supported (likewise J2-J4). Mount the CA file into Docker first.

# v0.2 read-only web dashboard (Docker Compose enables it automatically).
# Host-facing port and bind address; restrict access to your trusted network.
# AXIS_WEB_PORT=8080
# AXIS_WEB_BIND_ADDRESS=0.0.0.0
# Native executable/source: enable with AXIS_WEB_ENABLED=true; host defaults to 127.0.0.1.
# AXIS_WEB_ENABLED=true
# AXIS_WEB_HOST=127.0.0.1
